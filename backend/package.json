{
  "name": "ecommerce-backend",
  "version": "1.0.0",
  "description": "Clothing e-commerce backend API",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "jest --forceExit --runInBand"
  },
  "dependencies": {
    "@types/pg": "^8.21.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.23.0",
    "razorpay": "^2.9.8",
    "sqlite3": "^5.1.7",
    "stripe": "^14.5.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "jest": {
    "testTimeout": 60000,
    "forceExit": true,
    "projects": [
      {
        "displayName": "unit",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
          "**/tests/auth.unit.test.ts",
          "**/tests/cart.unit.test.ts",
          "**/tests/pbt.test.ts",
          "**/tests/rbac.test.ts"
        ]
      },
      {
        "displayName": "integration",
        "preset": "ts-jest",
        "testEnvironment": "node",
        "testMatch": [
          "**/tests/integration.test.ts"
        ],
        "setupFiles": [
          "./jest.integration.setup.js"
        ]
      }
    ]
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.7",
    "fast-check": "^4.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2"
  }
}
